# PostgreSQL is required for normal development/deployment. SQLite is only supported by tests.
DATABASE_URL=postgresql+psycopg://pathforge:pathforge@localhost:5432/pathforge
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
POSTGRES_DB=pathforge
POSTGRES_USER=pathforge
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional. Without this key, roadmap generation uses the clearly-labelled deterministic local planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30

